From 5ee51d7878119a0a4d7705e59b7870aaa6906bf2 Mon Sep 17 00:00:00 2001
From: mynameiseeyern <eeyern.ux@gmail.com>
Date: Thu, 1 Oct 2026 01:35:26 +1000
Subject: [PATCH] Case study label floats beside the article

The cover image is back to full width at its natural ratio. On screens
1100px and wider the bag label sits in a sticky sidebar to the right of the
reading column; below that it drops inline under the cover, two columns
on tablets and one on phones.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01N1pf5A4uCVK3vnmQqrUGB1
---
 app/globals.css          | 22 ++++++++++++++++++----
 app/work/[slug]/page.tsx | 15 ++++++++++-----
 2 files changed, 28 insertions(+), 9 deletions(-)

diff --git a/app/globals.css b/app/globals.css
index 97a227f..b4aeb54 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -337,9 +337,17 @@ a.card{color:inherit}
 .card .notes span{font-size:12px;padding:3px 8px;border-radius:999px;border:1px solid var(--rule);color:var(--ink-2);background:var(--paper)}
 
 /* ---------- case study bag label ---------- */
-.cs .bag-grid{margin-top:30px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px;align-items:start}
-.cs .bag-grid figure.cover{margin:0;aspect-ratio:1;height:100%}
-.cs .bag-grid figure.cover img{width:100%;height:100%;object-fit:cover}
+/* layout: reading column plus a floating label on wide screens; label drops inline under the cover on narrow ones */
+.cs-layout{width:min(100% - 40px,1100px);margin-inline:auto;display:grid;grid-template-columns:minmax(0,760px) 300px;gap:40px;align-items:start;justify-content:center}
+.cs-layout article{min-width:0}
+.bag-side{position:sticky;top:84px;padding-top:clamp(40px,7vh,72px)}
+.bag-side .bag{animation:none}
+.bag-inline{display:none;margin-top:22px}
+@media (max-width:1099px){
+  .cs-layout{grid-template-columns:minmax(0,760px)}
+  .bag-side{display:none}
+  .bag-inline{display:block}
+}
 .bag{border:1.5px solid var(--line);border-radius:12px;padding:18px 20px;background:var(--paper);position:relative;display:grid;gap:16px}
 .bag::before{content:"";position:absolute;inset:6px;border:1px dashed var(--rule);border-radius:8px;pointer-events:none}
 .bag-top{display:flex;justify-content:space-between;align-items:baseline}
@@ -359,7 +367,6 @@ a.card{color:inherit}
 .bag-blend li i{display:block;height:8px;border-radius:999px;background:var(--paper-2);position:relative;overflow:hidden}
 .bag-blend li i::after{content:"";position:absolute;inset:0;width:var(--w);background:var(--pen);border-radius:999px}
 .bag-blend li b{font-weight:500;text-align:right;font-variant-numeric:tabular-nums}
-@media (max-width:640px){.cs .bag-grid{grid-template-columns:1fr}.cs .bag-grid figure.cover{aspect-ratio:4/3;height:auto}}
 
 /* ---------- brew guide ---------- */
 .recipe{margin-top:34px;padding:18px 20px;border-radius:12px;background:var(--paper-2)}
@@ -370,3 +377,10 @@ a.card{color:inherit}
 .recipe dt{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);font-weight:500;padding-top:3px}
 .recipe dd{color:var(--ink)}
 @media (max-width:480px){.recipe dl div{grid-template-columns:1fr;gap:2px}}
+
+@media (min-width:600px) and (max-width:1099px){
+  .bag-inline .bag{grid-template-columns:1fr 1fr;column-gap:24px}
+  .bag-inline .bag-top{grid-column:1 / -1}
+  .bag-inline .bag-rows{grid-column:1}
+  .bag-inline .bag-notes,.bag-inline .bag-blend{grid-column:2}
+}
diff --git a/app/work/[slug]/page.tsx b/app/work/[slug]/page.tsx
index 913c5b1..06f4f39 100644
--- a/app/work/[slug]/page.tsx
+++ b/app/work/[slug]/page.tsx
@@ -88,7 +88,8 @@ export default async function CaseStudyPage({ params }: { params: Promise<{ slug
       <CrayonFilter />
       <Nav />
       <main id="top" className="cs">
-        <article className="col">
+        <div className="cs-layout">
+        <article>
           <Link className="back" href="/#work">
             <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.6" aria-hidden="true">
               <path d="M12 7H2M6 3 2 7l4 4" />
@@ -98,10 +99,10 @@ export default async function CaseStudyPage({ params }: { params: Promise<{ slug
           <h1>
             {cs.title} <span>{cs.subtitle}</span>
           </h1>
-          <div className="bag-grid">
-            <figure className="cover">
-              <Image src={cs.cover.src} alt={cs.cover.alt} width={cs.cover.width} height={cs.cover.height} priority sizes="(max-width: 800px) 100vw, 400px" />
-            </figure>
+          <figure className="cover">
+            <Image src={cs.cover.src} alt={cs.cover.alt} width={cs.cover.width} height={cs.cover.height} priority sizes="(max-width: 800px) 100vw, 760px" />
+          </figure>
+          <div className="bag-inline">
             <Label cs={cs} />
           </div>
           <p className="summary">{cs.summary}</p>
@@ -133,6 +134,10 @@ export default async function CaseStudyPage({ params }: { params: Promise<{ slug
             ))}
           </nav>
         </article>
+        <aside className="bag-side" aria-label="Project label, floating">
+          <Label cs={cs} />
+        </aside>
+        </div>
         <Footer />
       </main>
     </>
